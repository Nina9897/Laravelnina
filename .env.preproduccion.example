APP_NAME="Laravel Preproduccion"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://preproduccion.local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/laravel-preprod/shared/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log